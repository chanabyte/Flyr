# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# Google Calendar (see README: "Google Calendar setup")
# OAuth client of type "Web application" from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS address of this server (your tunnel), no trailing slash
PUBLIC_URL=
