# Where the app finds the Flyr server.
# Leave unset on home Wi-Fi (the app uses your laptop's IP automatically).
# On school/public Wi-Fi, use the same ngrok address as PUBLIC_URL in server/.env:
# EXPO_PUBLIC_API_URL=https://your-domain.ngrok-free.app

EXPO_PUBLIC_API_URL=raging-riveter-crimson.ngrok-free.dev
